# Downloaded benchmark data (Pons position sets — repo license is null,
# so they are fetched by scripts/pons_benchmark.py and never committed)
data/
# EXCEPTION (audit-fixes F-21, 2026-09-02): the encoder's vendored set prior.
# `rl/envs/randbats_prior.py` hard-requires `rl/envs/data/gen1_randbats_sets.json`
# (a 25 KB byte copy of showdown/data/random-battles/gen1/data.json, provenance in
# that module's docstring), and the `data/` rule above was silently swallowing it:
# the file existed only in the maintainer's working tree, so a fresh clone or a
# git worktree failed 20+ tests and could not encode a battle. Borrowed content,
# named in the module docstring and README per the standing obligation.
!rl/envs/data/
!rl/envs/data/gen1_randbats_sets.json

# Local Pokémon Showdown server checkout (Phase 5) — cloned at a pinned
# commit by scripts/setup_showdown.sh, never committed
showdown/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local environment
.env

# docs/prior_work/ is gitignored BY DEFAULT (third-party copyright + repo size). The rule for
# whitelisting, settled 2026-08-05: track a file iff its CONTENT is ours — the index and
# our own written analyses. A file we generated but whose content is someone else's stays
# ignored, which is why wang_fork_diffs.md does not appear below: it is 2,362 lines of
# another author's source diffs wrapped in a thin layer of our commentary.
docs/prior_work/*
!docs/prior_work/README.md
!docs/prior_work/PHASE5_PRIOR_WORK_BRIEFING.md
!docs/prior_work/CROSS_FEATURES_AND_ARCHITECTURE.md
!docs/prior_work/LLM_IN_RL_REPORT.md
!docs/prior_work/DISTILLATION_OBJECTIVES.md
!docs/prior_work/ARCH_SCREEN_SPEC.md
!docs/prior_work/HISTORY_FEATURES_DESIGN.md
!docs/prior_work/HUANG_LEE_DEEP_READ.md
!docs/prior_work/THROUGHPUT_SPEC.md
!docs/prior_work/RESEARCH_2026-08-10_prior_art_and_levers.md
logs/
