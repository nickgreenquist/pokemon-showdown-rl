diff --git a/fp/tape.py b/fp/tape.py
new file mode 100644
index 0000000..1068343
--- /dev/null
+++ b/fp/tape.py
@@ -0,0 +1,69 @@
+# ADDED (pokemon-showdown-rl): demonstration tape writer.
+#
+# Records Foul Play's battles as a raw, replayable event stream so that the
+# demonstration dataset is NOT welded to any particular observation encoder.
+# Two event kinds, written in the order they occur:
+#
+#   {"k":"m","v":<raw inbound websocket message>}
+#   {"k":"d","tag":...,"rqid":...,"choice":...,"policy":[[move,prob],...],
+#    "values":{move: avg_score}, "forced":bool}
+#
+# Interleaving is the point: the reconstructor replays messages into a
+# poke-env Battle and, when it reaches a decision event, the battle object is
+# in exactly the state Foul Play saw when it chose. Because Foul Play OWNS the
+# seat, the tape contains the `|request|` JSONs, so there is no hidden-action
+# problem and no belief reconstruction -- the thing that makes the human
+# replay corpus expensive does not arise here.
+#
+# Enabled by setting FP_TAPE_DIR. No-op otherwise, so stock behaviour is
+# unchanged when we are not collecting.
+
+import json
+import os
+import threading
+
+_DIR = os.environ.get("FP_TAPE_DIR")
+_lock = threading.Lock()
+_fh = None
+
+
+def enabled() -> bool:
+    return _DIR is not None
+
+
+def _handle():
+    global _fh
+    if _fh is None:
+        os.makedirs(_DIR, exist_ok=True)
+        path = os.path.join(_DIR, "run_{}.jsonl".format(os.getpid()))
+        _fh = open(path, "a", buffering=1)
+    return _fh
+
+
+def write(obj) -> None:
+    if _DIR is None:
+        return
+    with _lock:
+        fh = _handle()
+        fh.write(json.dumps(obj, separators=(",", ":")) + "\n")
+
+
+def message(raw: str) -> None:
+    write({"k": "m", "v": raw})
+
+
+def decision(tag, rqid, choice, policy=None, values=None, forced=False,
+             placeholder=False, trap_kind=None) -> None:
+    write(
+        {
+            "k": "d",
+            "tag": tag,
+            "rqid": rqid,
+            "choice": choice,
+            "policy": policy,
+            "values": values,
+            "forced": forced,
+            "placeholder": placeholder,
+            "trap_kind": trap_kind,
+        }
+    )
